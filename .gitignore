.DS_Store
Thumbs.db

# Credentials and private configuration must never enter the repository.
.env
.env.*
*.pem
*.key
*.p12

# Personal attachments are not part of this text/HTML handbook.
*.pdf
*.docx
*.doc
*.pptx
*.xlsx
